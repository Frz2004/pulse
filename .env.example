# ------------------------------------------------------------------
# Pulse 环境变量示例
# 复制为 .env 后填写真实值：cp .env.example .env
# 仅带 VITE_ 前缀的变量会打进浏览器端产物，切勿把密钥写成 VITE_。
# ------------------------------------------------------------------

# --- Supabase 客户端（浏览器端可见，用 anon/publishable key） ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# --- Supabase 服务端（仅供 Server Functions / Cloudflare Worker 使用） ---
# 服务角色密钥拥有最高权限，只允许出现在服务端环境，严禁暴露给浏览器。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- DeepSeek（掌纹解读 / AI 文案等服务端调用） ---
DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- PostHog 产品分析（可选，留空即关闭） ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- CI（.github/workflows/ci.yml 需要，构建时注入） ---
# VITE_SUPABASE_PROJECT_ID=your-project-ref
